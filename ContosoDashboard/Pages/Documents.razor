@page "/documents"
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using System.Security.Claims
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>Documents</h1>
            <p class="text-muted">Upload, search, and review files tied to your work.</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Upload a document</h5>
        </div>
        <div class="card-body">
            <EditForm Model="uploadModel" OnValidSubmit="HandleUploadAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Title</label>
                        <InputText class="form-control" @bind-Value="uploadModel.Title" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <InputSelect class="form-select" @bind-Value="uploadModel.Category">
                            <option value="">Select a category</option>
                            <option value="Project Documents">Project Documents</option>
                            <option value="Team Resources">Team Resources</option>
                            <option value="Personal Files">Personal Files</option>
                            <option value="Reports">Reports</option>
                            <option value="Presentations">Presentations</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" @bind-Value="uploadModel.Description" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Project</label>
                        <InputSelect class="form-select" @bind-Value="uploadModel.ProjectId">
                            <option value="">No project</option>
                            @foreach (var project in availableProjects)
                            {
                                <option value="@project.ProjectId">@project.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Document</label>
                        <InputFile class="form-control" OnChange="HandleFileSelected" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3 mb-0">
                        @statusMessage
                    </div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@isUploading">
                        @(isUploading ? "Uploading..." : "Upload document")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Recent documents</h5>
        </div>
        <div class="card-body">
            @if (documents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Project</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in documents)
                            {
                                <tr>
                                    <td>@document.Title</td>
                                    <td>@document.Category</td>
                                    <td>@(document.Project?.Name ?? "Personal")</td>
                                    <td>@FormatFileSize(document.FileSizeBytes)</td>
                                    <td>@document.UploadDateUtc.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No documents uploaded yet.</p>
            }
        </div>
    </div>
</div>

@code {
    private readonly UploadDocumentModel uploadModel = new();
    private readonly List<Document> documents = new();
    private readonly List<Project> availableProjects = new();
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isUploading;
    private int currentUserId;
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var claimsUserId = user.FindFirst(ClaimTypes.NameIdentifier);
        if (claimsUserId != null && int.TryParse(claimsUserId.Value, out var parsedUserId))
        {
            currentUserId = parsedUserId;
        }

        if (currentUserId > 0)
        {
            var userProjects = await ProjectService.GetUserProjectsAsync(currentUserId);
            availableProjects.AddRange(userProjects);

            documents.AddRange(await DocumentService.GetVisibleDocumentsAsync(currentUserId));
        }
    }

    private async Task HandleUploadAsync()
    {
        if (selectedFile == null)
        {
            statusMessage = "Please choose a file to upload.";
            isError = true;
            return;
        }

        if (currentUserId <= 0)
        {
            statusMessage = "You must be signed in to upload documents.";
            isError = true;
            return;
        }

        isUploading = true;
        try
        {
            var validation = await DocumentService.ValidateUploadAsync(
                selectedFile.Name,
                selectedFile.Size,
                uploadModel.Title,
                uploadModel.Category,
                uploadModel.ProjectId);

            if (!validation.IsValid)
            {
                statusMessage = validation.ErrorMessage;
                isError = true;
                return;
            }

            var document = new Document
            {
                Title = uploadModel.Title,
                Description = uploadModel.Description,
                Category = uploadModel.Category,
                FileName = selectedFile.Name,
                FileType = selectedFile.ContentType,
                FileSizeBytes = selectedFile.Size,
                ProjectId = uploadModel.ProjectId,
                Tags = uploadModel.Tags,
                IsDeleted = false
            };

            await using var memoryStream = new MemoryStream();
            await selectedFile.OpenReadStream(long.MaxValue).CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var savedDocument = await DocumentService.UploadAsync(document, memoryStream, currentUserId);
            documents.Insert(0, savedDocument);
            statusMessage = $"Document '{savedDocument.Title}' uploaded successfully.";
            isError = false;
            uploadModel.Reset();
            selectedFile = null;
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        var order = 0;

        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }

    private class UploadDocumentModel
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public int? ProjectId { get; set; }
        public string Tags { get; set; } = string.Empty;

        public void Reset()
        {
            Title = string.Empty;
            Description = string.Empty;
            Category = string.Empty;
            ProjectId = null;
            Tags = string.Empty;
        }
    }
}
